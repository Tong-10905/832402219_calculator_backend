<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fzu</groupId>
    <artifactId>calculator-backend</artifactId>
    <version>1.0.0</version>
    <name>calculator-backend</name>
    <description>Front-end/back-end separated calculator system - back-end API</description>

    <properties>
        <java.version>17</java.version>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
        <hibernate-community.version>6.5.3.Final</hibernate-community.version>
        <exp4j.version>0.4.8</exp4j.version>
    </properties>

    <dependencies>
        <!-- Web: provides REST API capability (embedded Tomcat + Spring MVC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA: operates the database through interfaces without handwriting SQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- SQLite JDBC driver -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <!-- Hibernate SQLite dialect (official Hibernate does not include SQLite) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>${hibernate-community.version}</version>
        </dependency>

        <!-- Safe mathematical expression parsing library (builds its own syntax tree,
             never executes user input as code, so eval/exec is not used) -->
        <dependency>
            <groupId>net.objecthunter</groupId>
            <artifactId>exp4j</artifactId>
            <version>${exp4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
